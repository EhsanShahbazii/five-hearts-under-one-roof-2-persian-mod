      "HIDE": 1.9
    },
    "SCRIPT": {
      "KOREAN": "우선 님 어떻게 생각하세요?",
      "ENGLISH": "About Assistant Choi Woo‑sun?",
      "CHINESE_SIMPLIFIED": "您觉得优先怎么样？",
      "CHINESE_TRADITIONAL": "你覺得崔宇善這個人怎麼樣？",
      "JAPANESE": "ウソンさんのこと、どう思います？",
      "INDONESIAN": "Tentang Asisten Choi Woo‑sun?",
      "PORTUGUESE": "O que acha do senhor Woo-seon?",
      "SPANISH": "¿Qué piensa del señor Woo-seon?",
      "PERSIAN": "درباره دستیار چوی وو سان؟"
    }
  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 2.1,
      "HIDE": 4.1
    },
    "SCRIPT": {
      "KOREAN": "최우선? 갑자기?",
      "ENGLISH": "Choi Woo‑sun? Out of nowhere?",
      "CHINESE_SIMPLIFIED": "崔优先？突然问这个？",
      "CHINESE_TRADITIONAL": "崔宇善？怎麼突然問這個？",
      "JAPANESE": "チェ・ウソン？いきなり何？",
      "INDONESIAN": "Choi Woo‑sun? Tiba-tiba banget nih?",
      "PORTUGUESE": "Woo-seon Choi? Do nada?",
      "SPANISH": "¿Woo-seon Choi? ¿De la nada?",
      "PERSIAN": "چوی وو سان؟ از هیچ جا؟"
    }
  },
  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 4.6,
      "HIDE": 6.3
    },
    "SCRIPT": {
      "KOREAN": "아니 그냥 궁금해서요.",
      "ENGLISH": "I was just curious.",
      "CHINESE_SIMPLIFIED": "啊，就是有点好奇",
      "CHINESE_TRADITIONAL": "沒有，就只是好奇",
      "JAPANESE": "ただ気になって",
      "INDONESIAN": "Aku cuma penasaran aja.",
      "PORTUGUESE": "Só fiquei curioso.",
      "SPANISH": "Solo tenía curiosidad.",
      "PERSIAN": "فقط کنجکاو بودم"
    }
  },
  {
    "INDEX": 4.0,
    "TIME": {
      "SHOW": 7.3,
      "HIDE": 10.2
    },
    "SCRIPT": {
      "KOREAN": "음... 우선 씨 괜찮지.",
      "ENGLISH": "Hmm… Woo‑sun’s good.",
      "CHINESE_SIMPLIFIED": "嗯...优先人不错",
      "CHINESE_TRADITIONAL": "嗯... 宇善這個人不錯啊",
      "JAPANESE": "うーん、悪くない人よ",
      "INDONESIAN": "Hmm… Woo‑sun itu oke sih.",
      "PORTUGUESE": "Hmm... Woo-seon é bom.",
      "SPANISH": "Mmm… Woo-seon está bien.",
      "PERSIAN": "هوم... وو سان خوب است."
    }
  },
  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 10.6,
      "HIDE": 14.3
    },
    "SCRIPT": {
      "KOREAN": "일 잘하고 성실하고 센스있고",
      "ENGLISH": "Works well, sincere, has good sense —",
      "CHINESE_SIMPLIFIED": "工作能力强，认真踏实，也很有眼力见",
      "CHINESE_TRADITIONAL": "工作能力好、又老實，而且很有Sense",
      "JAPANESE": "仕事できるし、真面目でセンスもある",
      "INDONESIAN": "Kerjanya oke, tulus, punya insting yang bagus—",
      "PORTUGUESE": "Trabalha bem, é responsável e perspicaz.",
      "SPANISH": "Trabaja bien, es responsable y es perspicaz.",
      "PERSIAN": "خوب کار می کند، صمیمانه، حس خوبی دارد -"
    }
  },
  {
    "INDEX": 6.0,
    "TIME": {
      "SHOW": 15.0,
      "HIDE": 17.8
    },
    "SCRIPT": {
      "KOREAN": "뭔가 키워보고 싶다는 생각이 든달까?",
