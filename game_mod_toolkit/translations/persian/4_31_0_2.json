      "SPANISH": "¿Y fuera del trabajo?",
      "PERSIAN": "منظورم خارج از کار است."
    }
  },
  {
    "INDEX": 8.0,
    "TIME": {
      "SHOW": 20.1,
      "HIDE": 21.2
    },
    "SCRIPT": {
      "KOREAN": "일 말고?",
