    "SCRIPT": {
      "KOREAN": "으아악!",
      "ENGLISH": "AAAAK! Argh!!!",
      "PERSIAN": "آاااخ! وای!!"
    }
  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 1.3,
      "HIDE": 2.7
    },
    "SCRIPT": {
      "KOREAN": "- 으아악!\n- 환자분 괜찮으세요??",
      "ENGLISH": "- AAAAK! Argh!!!\n- Sir, are you okay??",
      "PERSIAN": "—آاااخ! وای!! —آقا، حالتون خوبه؟؟"
    }
  },
  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 4.2,
      "HIDE": 5.8
    },
    "SCRIPT": {
      "KOREAN": "유만 씨 제 말 들리세요? 괜찮으세요?",
      "ENGLISH": "Mr. Yuman, can you hear me? Are you alright?",
      "PERSIAN": "آقای یومان، صدامو می‌شنوین؟ خوبین؟"
    }
  },
  {
    "INDEX": 4.0,
    "TIME": {
      "SHOW": 9.4,
      "HIDE": 10.3
    },
    "SCRIPT": {
      "KOREAN": "네.. 네",
      "ENGLISH": "Uh… yeah.",
      "PERSIAN": "امم... آره."
    }
  },
  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 10.3,
      "HIDE": 12.3
    },
    "SCRIPT": {
      "KOREAN": "자, 유만 씨 침대로 올려드릴게요.",
      "ENGLISH": "Alright, I’ll help you onto the bed, Mr. Yuman.",
      "PERSIAN": "خیلی خب، کمکتون می‌کنم برگردین رو تخت، آقای یومان."
    }
  },
  {
    "INDEX": 6.0,
    "TIME": {
      "SHOW": 14.5,
      "HIDE": 17.5
    },
    "SCRIPT": {
      "KOREAN": "중환자세요. 마음대로 움직이시면 안 됩니다!",
      "ENGLISH": "You’ve got serious injuries. You shouldn’t be moving on your own!",
      "PERSIAN": "شما آسیب‌دیدگی شدید دارین. اصلاً نباید خودتون تنهایی راه برین!"
    }
  },
  {
    "INDEX": 7.0,
    "TIME": {
      "SHOW": 18.0,
      "HIDE": 20.2
    },
    "SCRIPT": {
      "KOREAN": "간단한 검사 먼저 진행할게요.",
      "ENGLISH": "I’m going to do some basic checks first.",
      "PERSIAN": "اول چند تا معاینه ساده انجام می‌دم."
    }
  },
  {
    "INDEX": 8.0,
    "TIME": {
      "SHOW": 21.0,
      "HIDE": 22.8
    },
    "SCRIPT": {
      "KOREAN": "동공 반응 정상이시고요...",
      "ENGLISH": "Pupils look normal…",
      "PERSIAN": "مردمک‌ها که طبیعیه..."
    }
  },
  {
    "INDEX": 9.0,
    "TIME": {
      "SHOW": 24.0,
      "HIDE": 25.1
    },
    "SCRIPT": {
      "KOREAN": "열도 없으시고.",
      "ENGLISH": "No fever.",
      "PERSIAN": "تب هم ندارین."
    }
  },
  {
    "INDEX": 10.0,
    "TIME": {
      "SHOW": 26.6,
      "HIDE": 28.5
    },
    "SCRIPT": {
      "KOREAN": "발가락 한번 움직여 보시겠어요?",
      "ENGLISH": "Can you try wiggling your toes for me?",
      "PERSIAN": "میشه انگشتای پاتونو برام تکون بدین؟"
    }
  },
  {
    "INDEX": 11.0,
    "TIME": {
      "SHOW": 30.6,
      "HIDE": 32.5
    },
    "SCRIPT": {
      "KOREAN": "그럼 손 한번 쥐어보세요.",
      "ENGLISH": "Now, squeeze my hand?",
      "PERSIAN": "حالا دستمو فشار بدین؟"
    }
  },
  {
    "INDEX": 12.0,
    "TIME": {
      "SHOW": 33.7,
      "HIDE": 35.0
    },
    "SCRIPT": {
      "KOREAN": "음...",
      "ENGLISH": "Hmm…",
      "PERSIAN": "امم..."
    }
  },
  {
    "INDEX": 13.0,
    "TIME": {
      "SHOW": 35.7,
      "HIDE": 38.0
    },
    "SCRIPT": {
      "KOREAN": "아직 손에 힘이 안 들어가시는구나.",
      "ENGLISH": "You still don’t have any strength in your hand yet.",
      "PERSIAN": "هنوز توی دستتون هیچ جونی نیست."
    }
  },
  {
    "INDEX": 14.0,
    "TIME": {
      "SHOW": 39.2,
      "HIDE": 41.5
    },
    "SCRIPT": {
      "KOREAN": "혹시 다른 데 불편하신 곳은 없으세요?",
      "ENGLISH": "Anywhere else feeling off?",
      "PERSIAN": "جای دیگه‌ایم هست که درد یا ناراحتی حس کنین؟"
    }
  }
