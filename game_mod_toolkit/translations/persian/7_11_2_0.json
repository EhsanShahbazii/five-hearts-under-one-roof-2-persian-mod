[
  {
    "INDEX": 1.0,
    "TIME": {
      "SHOW": 4.3,
      "HIDE": 6.0
    },
    "SCRIPT": {
      "KOREAN": "어서오세요. 몇 분이서 오셨어요?",
      "ENGLISH": "Welcome. How many in your party?",
      "CHINESE_SIMPLIFIED": "欢迎光临，请问几位？",
      "CHINESE_TRADITIONAL": "歡迎光臨，請問幾位？",
      "JAPANESE": "いらっしゃいませ 何名様ですか？",
      "INDONESIAN": "Selamat datang. Rombongan berapa orang?",
      "PORTUGUESE": "Bem-vindo. Quantos são?",
      "SPANISH": "Bienvenido. ¿Cuántos son?",
      "PERSIAN": "خوش آمدید. چند نفر در حزب شما؟"
    }
  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 7.1,
      "HIDE": 8.4
    },
    "SCRIPT": {
      "KOREAN": "여기 고말숙 있죠.",
      "ENGLISH": "Is Go Mal-sook here?",
      "CHINESE_SIMPLIFIED": "我找高末淑",
      "CHINESE_TRADITIONAL": "高末淑在這裡吧",
      "JAPANESE": "ここにコ・マルスクさん、いますよね？",
      "INDONESIAN": "Apa Go Mal-sook ada di sini?",
      "PORTUGUESE": "A Go Malsook tá aqui?",
      "SPANISH": "¿Aquí está Go Malsook?",
      "PERSIAN": "گو مال‌سوک اینجاست؟"
    }
  },
  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 9.2,
      "HIDE": 10.3
    },
    "SCRIPT": {
      "KOREAN": "그게... 누군데요. ",
      "ENGLISH": "Who’s that?",
      "CHINESE_SIMPLIFIED": "你说的...是谁啊？",
      "CHINESE_TRADITIONAL": "你說的...是誰呢？",
      "JAPANESE": "え…どなたですか？",
      "INDONESIAN": "Siapa tuh?",
      "PORTUGUESE": "Desculpe? Quem é o senhor?",
      "SPANISH": "¿Perdón? ¿Quién es usted?",
      "PERSIAN": "اون کیه؟"
    }
  },
  {
    "INDEX": 4.0,
    "TIME": {
      "SHOW": 10.6,
      "HIDE": 12.5
    },
    "SCRIPT": {
      "KOREAN": "여기 그런 사람 없으니까 얼른 나가세요.",
      "ENGLISH": "We don’t have anyone by that name. Please leave.",
      "CHINESE_SIMPLIFIED": "我们这没这个人，请你赶紧出去",
      "CHINESE_TRADITIONAL": "我們這邊沒有這個人，請趕快出去",
      "JAPANESE": "ここにはそんな方いません すぐにお帰りください",
      "INDONESIAN": "Kami nggak punya siapa pun dengan nama itu. Silakan keluar.",
      "PORTUGUESE": "Aqui não tem ninguém com esse nome, então vá embora.",
      "SPANISH": "Aquí no hay nadie con ese nombre, así que váyase.",
      "PERSIAN": "ما کسی به این نام نداریم لطفا ترک کنید."
    }
  },
  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 14.2,
      "HIDE": 15.6
    },
    "SCRIPT": {
      "KOREAN": "나가시라고요 ",
      "ENGLISH": "I said leave.",
      "CHINESE_SIMPLIFIED": "请出去",
      "CHINESE_TRADITIONAL": "請您出去",
      "JAPANESE": "お帰りください",
      "INDONESIAN": "Saya bilang keluar.",
      "PORTUGUESE": "Tô dizendo pra ir embora.",
      "SPANISH": "Le digo que se vaya.",
      "PERSIAN": "گفتم برو"
    }
  },
  {
    "INDEX": 6.0,
    "TIME": {
      "SHOW": 15.7,
      "HIDE": 17.3
    },
    "SCRIPT": {
      "KOREAN": "영업 방해하면 경찰 부릅니다.",
      "ENGLISH": "If you disrupt the business, I’ll call the police.",
      "CHINESE_SIMPLIFIED": "再妨碍营业我们就报警了",
      "CHINESE_TRADITIONAL": "如果妨礙營業的話我們就報警了",
      "JAPANESE": "営業の妨げになるなら警察を呼びますよ",
      "INDONESIAN": "Kalau bikin keributan, saya panggil polisi.",
      "PORTUGUESE": "Se continuar atrapalhando o negócio, vou chamar a polícia.",
      "SPANISH": "Si sigue molestando el negocio, voy a llamar a la policía.",
      "PERSIAN": "اگر کار را مختل کنید، با پلیس تماس می‌گیرم."
    }
  },
  {
    "INDEX": 7.0,
    "TIME": {
      "SHOW": 17.5,
      "HIDE": 19.3
    },
    "SCRIPT": {
      "KOREAN": "하, 이거 놔요",
