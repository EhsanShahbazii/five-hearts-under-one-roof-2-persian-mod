      "INDONESIAN": "Hah? Nggak, belum…",
      "PORTUGUESE": "Ah? Esqueci…",
      "SPANISH": "¿Ah? Lo olvidé…",
      "PERSIAN": "ها؟ نه، نداشتم…"
    }
  },
  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 8.5,
      "HIDE": 10.8
    },
    "SCRIPT": {
