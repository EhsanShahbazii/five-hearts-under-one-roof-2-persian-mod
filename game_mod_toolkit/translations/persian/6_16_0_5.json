    },
    "SCRIPT": {
      "KOREAN": "유만 님! 생일 축하드려요!",
      "ENGLISH": "Yuman! Happy birthday!",
      "CHINESE_SIMPLIFIED": "宥万先生！祝你生日快乐！",
      "CHINESE_TRADITIONAL": "宥萬先生！祝你生日快樂！",
      "JAPANESE": "ユマンさん！お誕生日おめでとうございます！",
      "INDONESIAN": "Yuman! Selamat ulang tahun!",
      "PORTUGUESE": "Feliz aniversário, senhor Yumán!",
      "SPANISH": "¡Feliz cumpleaños, señor Yumán!",
      "PERSIAN": "یومان! تولدت مبارک!"
    }
  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 2.8,
      "HIDE": 4.3
    },
    "SCRIPT": {
      "KOREAN": "고마워요 유정 씨...",
      "ENGLISH": "Thank you, Yu-jeong...",
