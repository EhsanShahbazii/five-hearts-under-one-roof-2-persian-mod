  {
    "INDEX": 8.0,
    "TIME": {
      "SHOW": 15.1,
      "HIDE": 16.9
    },
    "SCRIPT": {
      "KOREAN": "그걸 왜 먹어요!",
      "ENGLISH": "Why’d you eat it?!",
