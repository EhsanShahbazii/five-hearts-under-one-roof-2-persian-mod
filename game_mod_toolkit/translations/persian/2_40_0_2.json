  },
  {
    "INDEX": 7.0,
    "TIME": {
      "SHOW": 14.5,
      "HIDE": 15.1
    },
    "SCRIPT": {
      "KOREAN": "뭐예요!",
      "ENGLISH": "Wait—what are you doing?!",
      "CHINESE_SIMPLIFIED": "什么呀！",
