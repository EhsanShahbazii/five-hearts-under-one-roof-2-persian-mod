  },
  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 3.9,
      "HIDE": 6.5
    },
    "SCRIPT": {
      "KOREAN": "유정 씨는 혹시 귀신... 믿어요?",
      "ENGLISH": "Yu-jeong, do you… believe in ghosts, by any chance?",
      "CHINESE_SIMPLIFIED": "你...相信鬼魂吗？",
      "CHINESE_TRADITIONAL": "有情小姐，你相信...有鬼嗎？",
      "JAPANESE": "ユジョンさんって、幽霊…信じます？",
      "INDONESIAN": "Yu-jeong, kamu… percaya hantu nggak sih?",
      "PERSIAN": "یو-جئونگ، به احتمال زیاد به ارواح اعتقاد داری؟"
    }
  },
  {
    "INDEX": 4.0,
    "TIME": {
      "SHOW": 7.3,
      "HIDE": 7.9
    },
    "SCRIPT": {
      "KOREAN": "네.",
      "ENGLISH": "I do.",
      "CHINESE_SIMPLIFIED": "相信",
      "CHINESE_TRADITIONAL": "相信啊",
      "JAPANESE": "はい",
      "INDONESIAN": "Percaya.",
      "PERSIAN": "من انجام می دهم."
    }
  },
  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 8.0,
      "HIDE": 9.4
    },
    "SCRIPT": {
      "KOREAN": "어... 진짜요...?",
      "ENGLISH": "Wait… seriously?",
      "CHINESE_SIMPLIFIED": "呃...真的吗...？",
      "CHINESE_TRADITIONAL": "哦...真的嗎...？",
      "JAPANESE": "え…本当に…？",
      "INDONESIAN": "Hah… serius?",
      "PERSIAN": "صبر کن... جدی؟"
    }
  },
  {
    "INDEX": 6.0,
    "TIME": {
      "SHOW": 10.3,
      "HIDE": 13.1
    },
    "SCRIPT": {
      "KOREAN": "저 사실... 귀신 보거든요.",
      "ENGLISH": "Actually… I can see them.",
      "CHINESE_SIMPLIFIED": "我其实...能看见鬼魂",
      "CHINESE_TRADITIONAL": "我其實..看得到...",
      "JAPANESE": "私、実は幽霊が見えるんです",
      "INDONESIAN": "Sebenernya… aku bisa liat mereka.",
      "PERSIAN": "در واقع... من می توانم اونا رو ببینم."
    }
  },
  {
    "INDEX": 7.0,
    "TIME": {
      "SHOW": 13.2,
      "HIDE": 13.5
    },
    "SCRIPT": {
      "KOREAN": "네??",
