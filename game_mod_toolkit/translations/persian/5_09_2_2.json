  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 2.0,
      "HIDE": 3.2
    },
    "SCRIPT": {
      "KOREAN": "네, 가요.",
      "ENGLISH": "Yeah, let’s go.",
      "CHINESE_SIMPLIFIED": "嗯，走吧",
