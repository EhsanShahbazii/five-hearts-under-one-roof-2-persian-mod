      "CHINESE_TRADITIONAL": "欸？？",
      "JAPANESE": "えっ！？",
      "INDONESIAN": "A-apa??",
      "PERSIAN": "و-چی؟؟"
    }
  },
  {
    "INDEX": 8.0,
    "TIME": {
      "SHOW": 14.9,
      "HIDE": 16.3
    },
    "SCRIPT": {
      "KOREAN": "귀신을 본다고요?",
