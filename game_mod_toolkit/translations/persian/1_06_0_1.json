  {
    "INDEX": 7.0,
    "TIME": {
      "SHOW": 18.7,
      "HIDE": 20.7
    },
    "SCRIPT": {
      "KOREAN": "아까보다 괜찮아지셨을까요?",
      "ENGLISH": "Does it feel better than before?",
