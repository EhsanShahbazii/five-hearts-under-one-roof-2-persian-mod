[
  {
    "INDEX": 1.0,
    "TIME": {
      "SHOW": 0.3,
      "HIDE": 3.1
    },
    "SCRIPT": {
      "KOREAN": "아, 여기가 그 하숙집이에요? ",
      "ENGLISH": "Oh, this is the boarding house?",
      "CHINESE_SIMPLIFIED": "啊，这里就是你说的那个合租房吗？",
      "CHINESE_TRADITIONAL": "啊，這裡就是你說的合宿公寓嗎？",
      "JAPANESE": "あ、ここがその下宿なんですか?",
      "INDONESIAN": "Oh, ini rumah kosnya?",
      "PORTUGUESE": "Ah, então aqui é a sua pensão?",
      "SPANISH": "Ah, ¿aquí es tu pensión?",
      "PERSIAN": "اوه، این پانسیون است؟"
    }
  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 3.1,
      "HIDE": 5.2
    },
    "SCRIPT": {
      "KOREAN": "한 사람당 한 층씩 쓰는 거예요?",
      "ENGLISH": "Does each person get their own floor?",
      "CHINESE_SIMPLIFIED": "是每人住一层吗？",
      "CHINESE_TRADITIONAL": "每個人是自己使用一層樓嗎？",
      "JAPANESE": "一人ずつ一階を使うんですか?",
      "INDONESIAN": "Setiap orang dapat satu lantai sendiri?",
      "PORTUGUESE": "Cada pessoa tem seu próprio andar?",
      "SPANISH": "¿Cada persona tiene su propio piso?",
      "PERSIAN": "هر فردی کف خود را دارد؟"
    }
  },
  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 5.6,
      "HIDE": 8.0
    },
    "SCRIPT": {
      "KOREAN": "아뇨, 한 층에 많게는 한 세 명씩?",
      "ENGLISH": "No, up to three people share a floor.",
      "CHINESE_SIMPLIFIED": "不是啦，一层最多能住三个人？",
      "CHINESE_TRADITIONAL": "不是耶，一層樓最多可以住到三個人",
      "JAPANESE": "いや、一階に多いと３人まで?",
      "INDONESIAN": "Nggak, maksimal tiga orang berbagi satu lantai.",
      "PORTUGUESE": "Não, em um andar podem morar até três pessoas.",
      "SPANISH": "No, en un piso pueden vivir hasta tres personas.",
      "PERSIAN": "نه، حداکثر سه نفر در یک طبقه مشترک هستند."
    }
  },
  {
    "INDEX": 4.0,
    "TIME": {
      "SHOW": 8.1,
      "HIDE": 9.0
    },
    "SCRIPT": {
      "KOREAN": "세 명?",
      "ENGLISH": "Three?",
      "CHINESE_SIMPLIFIED": "三个人？",
      "CHINESE_TRADITIONAL": "三個人？",
      "JAPANESE": "３人?",
      "INDONESIAN": "Tiga orang?",
      "PORTUGUESE": "Três?",
      "SPANISH": "¿Tres?",
      "PERSIAN": "سه؟"
    }
  },
  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 9.0,
      "HIDE": 10.5
    },
    "SCRIPT": {
      "KOREAN": "그게 가능해요?",
      "ENGLISH": "Seriously? That’s allowed?",
      "CHINESE_SIMPLIFIED": "这能住得下吗？",
      "CHINESE_TRADITIONAL": "這麼多人住得下嗎？",
      "JAPANESE": "それって可能なんですか?",
      "INDONESIAN": "Serius? Emang boleh?",
      "PORTUGUESE": "Isso é permitido?",
      "SPANISH": "¿Eso se puede?",
      "PERSIAN": "جدی؟ این مجاز است؟"
    }
  },
  {
    "INDEX": 6.0,
    "TIME": {
      "SHOW": 10.5,
      "HIDE": 12.7
    },
    "SCRIPT": {
      "KOREAN": "야. 이 사람 누군데?",
      "ENGLISH": "Hey, who’s this girl?",
      "CHINESE_SIMPLIFIED": "喂，这人是谁啊？",
      "CHINESE_TRADITIONAL": "喂。這個人是誰啊？",
      "JAPANESE": "ねえ、あの人誰?",
      "INDONESIAN": "Eh, cewek ini siapa?",
      "PORTUGUESE": "Ei, e quem é ela?",
      "SPANISH": "Oye, ¿y quién es ella?",
      "PERSIAN": "هی این دختر کیه"
    }
  },
  {
    "INDEX": 7.0,
    "TIME": {
      "SHOW": 13.0,
      "HIDE": 15.5
    },
    "SCRIPT": {
      "KOREAN": "몰라. 나도 오늘 처음 봤는데",
      "ENGLISH": "No clue. Just met her at the hospital today.",
      "CHINESE_SIMPLIFIED": "不知道，我也是今天在医院第一次见",
      "CHINESE_TRADITIONAL": "不知道，我也是今天在醫院第一次見到他",
      "JAPANESE": "さあ、俺も今日初めて見たんだけど",
      "INDONESIAN": "Nggak tahu. Baru ketemu di rumah sakit tadi.",
      "PORTUGUESE": "Nem ideia. Eu também conheci ela hoje.",
      "SPANISH": "Ni idea. Yo también la conocí hoy.",
      "PERSIAN": "هیچ سرنخی. همین امروز اونو در بیمارستان ملاقات کردم."
    }
  },
  {
    "INDEX": 8.0,
    "TIME": {
      "SHOW": 15.6,
      "HIDE": 17.7
    },
    "SCRIPT": {
      "KOREAN": "나한테 뭐 빚진 게 있대.",
      "ENGLISH": "She said she owe me something.",
      "CHINESE_SIMPLIFIED": "她说她欠了我人情",
      "CHINESE_TRADITIONAL": "她說他欠了我人情",
      "JAPANESE": "なんか俺に借りがあるとか言ってた",
      "INDONESIAN": "Katanya dia punya utang sama aku.",
      "PORTUGUESE": "Disse que temos uma dívida.",
      "SPANISH": "Dice que tenemos una deuda.",
      "PERSIAN": "گفت یه چیزی به من بدهکاره"
    }
  },
  {
    "INDEX": 9.0,
    "TIME": {
      "SHOW": 17.7,
      "HIDE": 19.7
    },
    "SCRIPT": {
      "KOREAN": "빚?? 무슨 빚?",
      "ENGLISH": "Owe you? Owe you what?",
      "CHINESE_SIMPLIFIED": "欠你？欠你什么？",
      "CHINESE_TRADITIONAL": "欠你？欠了什麼？",
      "JAPANESE": "借り?? どんな借り?",
      "INDONESIAN": "Utang? Utang apa?",
      "PORTUGUESE": "Dívida? Que dívida?",
      "SPANISH": "¿Deuda? ¿Qué deuda?",
      "PERSIAN": "مدیون شما؟ بدهکارت چیه؟"
    }
  },
  {
    "INDEX": 10.0,
    "TIME": {
      "SHOW": 20.0,
      "HIDE": 22.8
    },
    "SCRIPT": {
      "KOREAN": "그게 뭔진 안 알려줘서 나도 모르겠어.",
      "ENGLISH": "She wouldn’t say it. I don’t know either.",
      "CHINESE_SIMPLIFIED": "她没具体说是什么，我也不清楚",
      "CHINESE_TRADITIONAL": "沒說是什麼，我也有聽沒有懂",
      "JAPANESE": "それは教えてくれなくて、俺もよくわからない",
      "INDONESIAN": "Dia nggak mau bilang. Aku juga nggak tahu.",
      "PORTUGUESE": "Não me contou, então também não sei.",
      "SPANISH": "No me lo dijo, así que tampoco lo sé.",
      "PERSIAN": "او اونو نمی گوید. من هم نمی دانم."
    }
  },
  {
    "INDEX": 11.0,
    "TIME": {
      "SHOW": 24.4,
      "HIDE": 25.2
    },
    "SCRIPT": {
      "KOREAN": "저기요!",
      "ENGLISH": "Excuse me!",
      "CHINESE_SIMPLIFIED": "这位小姐！",
      "CHINESE_TRADITIONAL": "不好意思！",
      "JAPANESE": "あの！",
      "INDONESIAN": "Permisi!",
      "PORTUGUESE": "Ei!",
      "SPANISH": "¡Oiga!",
      "PERSIAN": "ببخشید!"
    }
  },
  {
    "INDEX": 12.0,
    "TIME": {
      "SHOW": 25.2,
      "HIDE": 27.1
    },
    "SCRIPT": {
      "KOREAN": "여기 어떻게 오시게 된 거예요?",
      "ENGLISH": "Why are you here?",
      "CHINESE_SIMPLIFIED": "你是怎么到这儿来的？",
      "CHINESE_TRADITIONAL": "你怎麼會到這裡來的？",
      "JAPANESE": "ここにはどうして来たんですか?",
      "INDONESIAN": "Kamu ngapain di sini?",
      "PORTUGUESE": "Pra que veio aqui?",
      "SPANISH": "¿Para qué ha venido?",
      "PERSIAN": "چرا اینجایی؟"
    }
  },
  {
    "INDEX": 13.0,
    "TIME": {
      "SHOW": 27.1,
      "HIDE": 28.8
    },
    "SCRIPT": {
      "KOREAN": "그냥 지나가다가...",
      "ENGLISH": "I was just passing by...",
      "CHINESE_SIMPLIFIED": "就是路过...",
      "CHINESE_TRADITIONAL": "就只是路過…",
      "JAPANESE": "たまたま通りかかって…",
      "INDONESIAN": "Aku cuma lagi lewat...",
      "PORTUGUESE": "Só tava passando...",
      "SPANISH": "Solo pasaba por aquí...",
      "PERSIAN": "همین الان داشتم می گذشتم..."
    }
  },
  {
    "INDEX": 14.0,
    "TIME": {
      "SHOW": 28.8,
      "HIDE": 30.3
    },
    "SCRIPT": {
      "KOREAN": "가볍게 들린 거예요.",
      "ENGLISH": "Thought I’d check the place out.",
      "CHINESE_SIMPLIFIED": "顺便溜达过来看看",
      "CHINESE_TRADITIONAL": "隨便進來看一下而已",
      "JAPANESE": "軽く寄っただけです",
      "INDONESIAN": "Pikir sekalian lihat-lihat tempatnya.",
      "PORTUGUESE": "e quis vir cumprimentar.",
      "SPANISH": "y quise venir a saludar.",
      "PERSIAN": "فکر کردم مکان را بررسی کنم."
    }
  },
  {
    "INDEX": 15.0,
    "TIME": {
      "SHOW": 30.6,
      "HIDE": 33.6
    },
    "SCRIPT": {
      "KOREAN": "설마... 하숙하러 온 거 아니죠?",
      "ENGLISH": "Wait, you're not here to move in, right?",
      "CHINESE_SIMPLIFIED": "该不会...你是想来合租的吧？",
      "CHINESE_TRADITIONAL": "難道…你是想來這邊租房嗎？",
      "JAPANESE": "まさか…下宿しに来たんじゃないですよね?",
      "INDONESIAN": "Tunggu, kamu bukan mau pindah ke sini, kan?",
      "PORTUGUESE": "Não me diga que... tá procurando hospedagem?",
      "SPANISH": "No me diga que... ¿está buscando hospedaje?",
      "PERSIAN": "صبر کن، برای نقل مکان اینجا نیستی، درست است؟"
    }
  },
  {
    "INDEX": 16.0,
    "TIME": {
      "SHOW": 33.6,
      "HIDE": 33.9
    },
    "SCRIPT": {
      "KOREAN": "네?",
      "ENGLISH": "What?",
      "CHINESE_SIMPLIFIED": "嗯？",
      "CHINESE_TRADITIONAL": "嗯？",
      "JAPANESE": "え?",
      "INDONESIAN": "Apa?",
      "PORTUGUESE": "Hã?",
      "SPANISH": "¿Eh?",
      "PERSIAN": "چی؟"
    }
  },
  {
    "INDEX": 17.0,
    "TIME": {
      "SHOW": 33.9,
      "HIDE": 34.7
    },
    "SCRIPT": {
      "KOREAN": "제가요?",
      "ENGLISH": "Me?",
      "CHINESE_SIMPLIFIED": "我吗？",
      "CHINESE_TRADITIONAL": "我嗎？",
      "JAPANESE": "私が?",
      "INDONESIAN": "Aku?",
      "PORTUGUESE": "Eu?",
      "SPANISH": "¿Yo?",
      "PERSIAN": "من؟"
    }
  },
  {
