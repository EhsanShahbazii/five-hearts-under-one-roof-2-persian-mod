    "TIME": {
      "SHOW": 34.7,
      "HIDE": 36.8
    },
    "SCRIPT": {
      "KOREAN": "여기서 하숙을 어떻게 해요.",
      "ENGLISH": "Live here?",
      "CHINESE_SIMPLIFIED": "我怎么可能在这里合租",
      "CHINESE_TRADITIONAL": "我怎麼可能在這裡合租房子？",
      "JAPANESE": "ここで下宿なんてするわけないでしょ！",
      "INDONESIAN": "Tinggal di sini?",
      "PORTUGUESE": "Como eu ia morar aqui?",
      "SPANISH": "¿Cómo voy a vivir aquí?",
      "PERSIAN": "اینجا زندگی کنم؟"
    }
  },
  {
    "INDEX": 19.0,
    "TIME": {
      "SHOW": 36.8,
      "HIDE": 38.9
    },
    "SCRIPT": {
      "KOREAN": "하. 진짜 아니에요?",
      "ENGLISH": "Really? You're sure?",
      "CHINESE_SIMPLIFIED": "哈，真不是？",
      "CHINESE_TRADITIONAL": "喔？真的不是嗎？",
      "JAPANESE": "は、本当に違うんですか?",
      "INDONESIAN": "Serius? Kamu yakin?",
      "PORTUGUESE": "Ha. Não veio pra ficar mesmo?",
      "SPANISH": "Ja. ¿De verdad no vino a quedarse?",
      "PERSIAN": "واقعا؟ مطمئنی؟"
    }
  },
  {
