    "TIME": {
      "SHOW": 56.4,
      "HIDE": 58.7
    },
    "SCRIPT": {
      "KOREAN": "매일 유만 씨 챙겨야 할 수도 있으니까요.",
      "ENGLISH": "Might need to take care of Yuman.",
      "CHINESE_SIMPLIFIED": "因为可能每天都得照顾宥万先生呢",
      "CHINESE_TRADITIONAL": "說不定每天都要照顧宥萬先生嘛",
      "JAPANESE": "もしかしたら毎日ユマンさんの世話しないといけないかもしれないから",
      "INDONESIAN": "Siapa tahu harus ngurusin Yuman.",
      "PORTUGUESE": "Caso tivesse que cuidar do Yumán todos os dias.",
      "SPANISH": "Por si tenía que cuidar de Yuman a diario.",
      "PERSIAN": "شاید نیاز به مراقبت از یومان باشد."
    }
  },
  {
    "INDEX": 30.0,
    "TIME": {
      "SHOW": 59.0,
      "HIDE": 60.9
    },
    "SCRIPT": {
      "KOREAN": "그쪽이 유만이를 왜 챙겨요?",
      "ENGLISH": "Why would you take care of Yuman?",
      "CHINESE_SIMPLIFIED": "你为什么要照顾吴宥万？",
      "CHINESE_TRADITIONAL": "你憑什麼要照顧宥萬？",
      "JAPANESE": "あんたがユマンの世話を?",
      "INDONESIAN": "Kenapa kamu harus ngurusin Yuman?",
      "PORTUGUESE": "E por que a senhora teria que cuidar do Yumán?",
      "SPANISH": "¿Y por qué tendría que cuidar usted a Yuman?",
      "PERSIAN": "چرا از یومان مراقبت می کنی؟"
    }
  },
  {
    "INDEX": 31.0,
    "TIME": {
      "SHOW": 60.9,
      "HIDE": 63.0
    },
    "SCRIPT": {
      "KOREAN": "그건 말 못 할 사정이 좀 있어요. 언니.",
      "ENGLISH": "That’s... kind of personal, unnie.",
      "CHINESE_SIMPLIFIED": "这个嘛，有点难言之隐啦，姐姐",
      "CHINESE_TRADITIONAL": "這有點難言之隱。姊姊",
      "JAPANESE": "それにはちょっと言えない事情があるんです、お姉さん",
      "INDONESIAN": "Itu... agak pribadi, unnie.",
      "PORTUGUESE": "Tenho razões que não posso te contar, querida.",
      "SPANISH": "Tengo razones que no te puedo contar, querida.",
      "PERSIAN": "این ... یک جورهایی شخصی است."
    }
  },
  {
    "INDEX": 32.0,
    "TIME": {
      "SHOW": 63.5,
      "HIDE": 64.4
    },
    "SCRIPT": {
      "KOREAN": "언니?",
