      "CHINESE_SIMPLIFIED": "对！不是！",
      "CHINESE_TRADITIONAL": "對！真的不是",
      "JAPANESE": "はい！違います!",
      "INDONESIAN": "Iya! Sumpah!",
      "PORTUGUESE": "Sim! Claro que não!",
      "SPANISH": "¡Sí! ¡Claro que no!",
      "PERSIAN": "بله! قسم می خورم!"
    }
  },
