      "ENGLISH": "Now you can rest.",
      "CHINESE_SIMPLIFIED": "现在好好休息吧",
      "CHINESE_TRADITIONAL": "現在好好休息吧",
      "JAPANESE": "もうゆっくり休んで",
      "INDONESIAN": "Sekarang kamu bisa istirahat.",
      "PORTUGUESE": "Agora... descanse.",
      "SPANISH": "Ahora descansa.",
      "PERSIAN": "حالا میتونی استراحت کنی"
    }
  },
