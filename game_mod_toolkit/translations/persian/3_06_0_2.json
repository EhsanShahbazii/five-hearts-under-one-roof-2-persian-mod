      "PORTUGUESE": "Eu? Por quê?",
      "SPANISH": "¿Yo por qué?",
      "PERSIAN": "چرا من ~"
    }
  },
  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 4.6,
      "HIDE": 6.8
    },
    "SCRIPT": {
      "KOREAN": "언제는 여기가 너네 집이라며",
