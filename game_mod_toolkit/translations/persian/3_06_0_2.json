      "PORTUGUESE": "Malsook, acompanha a Minjung, por favor.",
      "SPANISH": "Malsook, acompaña a Minjung, por favor.",
      "PERSIAN": "مال‌سوک، می تونی مین‌جونگ رو به اطراف نشون بدی؟"
    }
  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 3.0,
      "HIDE": 4.1
    },
    "SCRIPT": {
      "KOREAN": "내가 왜~",
