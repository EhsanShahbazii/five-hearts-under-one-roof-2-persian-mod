      "JAPANESE": "ユ！",
      "INDONESIAN": "Jeong!",
      "PORTUGUESE": "A!",
      "SPANISH": "¡A!",
      "PERSIAN": "یو!"
    }
  },
  {
    "INDEX": 8.0,
    "TIME": {
      "SHOW": 10.8,
      "HIDE": 12.2
    },
    "SCRIPT": {
      "KOREAN": "유쾌한 이 순간을",
      "ENGLISH": "Yu(You) are the reason why we celebrate this moment!",
      "CHINESE_SIMPLIFIED": "有情有义的欢聚此刻",
      "CHINESE_TRADITIONAL": "有情有義的歡聚時光",
      "JAPANESE": "愉快なこの瞬間を",
      "INDONESIAN": "Jeong adalah alasan kenapa kita ngerayain momen ini!",
      "PORTUGUESE": "Alegria enchendo nossos corações!",
      "SPANISH": "¡Alegría llenando nuestros corazones!",
      "PERSIAN": "یو (شما) دلیلی هستید که این لحظه را جشن می گیریم!"
    }
  },
  {
