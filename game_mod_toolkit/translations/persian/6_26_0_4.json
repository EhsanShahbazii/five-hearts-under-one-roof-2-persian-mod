      "SPANISH": "Fuiste usted la que se lo tiró.",
      "PERSIAN": "اون تو بودی، نه؟"
    }
  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 2.5,
      "HIDE": 4.4
    },
    "SCRIPT": {
      "KOREAN": "아, 아니에요! ",
      "ENGLISH": "N-No! It was this chicken sound!",
