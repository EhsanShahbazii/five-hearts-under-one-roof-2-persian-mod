    },
    "SCRIPT": {
      "KOREAN": "그쪽이 뀐 거죠.",
      "ENGLISH": "That was you, wasn’t it?",
      "CHINESE_SIMPLIFIED": "是你放的吧",
      "CHINESE_TRADITIONAL": "是你放的吧",
      "JAPANESE": "そっちがおならしたんですよね？",
