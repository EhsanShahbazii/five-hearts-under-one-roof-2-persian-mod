      "JAPANESE": "はい！おならじゃないです！",
      "INDONESIAN": "iya! Sama sekali bukan kentut!",
      "PORTUGUESE": "sim! Não foi um pum!",
      "SPANISH": "sí! ¡No fue un gas!",
      "PERSIAN": "بله کلا گوز نیست!"
    }
  },
  {
    "INDEX": 6.0,
    "TIME": {
      "SHOW": 11.6,
      "HIDE": 13.8
    },
    "SCRIPT": {
