      "SPANISH": "¡N-no, no fui yo!",
      "PERSIAN": "ن-نه! این صدای مرغ بود!"
    }
  },
  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 4.5,
      "HIDE": 6.8
    },
    "SCRIPT": {
      "KOREAN": "이 닭소리에요!",
      "ENGLISH": "This—this thing right here!",
