      "SPANISH": "¡Fue este pollo!",
      "PERSIAN": "این - این چیز در اینجا!"
    }
  },
  {
    "INDEX": 4.0,
    "TIME": {
      "SHOW": 6.9,
      "HIDE": 8.6
    },
    "SCRIPT": {
      "KOREAN": "아 그거였어요?",
