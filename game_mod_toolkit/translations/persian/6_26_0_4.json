      "CHINESE_TRADITIONAL": "啊，原來是這個啊？",
      "JAPANESE": "あ、それだったんですか？",
      "INDONESIAN": "Oh… jadi itu ya suaranya?",
      "PORTUGUESE": "Ah, era isso?",
      "SPANISH": "¿Ah, era eso?",
      "PERSIAN": "اوه... همین بود؟"
    }
  },
  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 9.5,
      "HIDE": 10.7
    },
    "SCRIPT": {
      "KOREAN": "네! 방귀 아닙니다...!",
      "ENGLISH": "yep! Totally not a fart!",
