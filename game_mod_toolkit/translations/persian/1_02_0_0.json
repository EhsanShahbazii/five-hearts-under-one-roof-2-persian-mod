    "TIME": {
      "SHOW": 0.7,
      "HIDE": 1.1
    },
    "SCRIPT": {
      "KOREAN": "정신 차려보세요.",
      "ENGLISH": "Can you hear me?",
      "PERSIAN": "صدامو می‌شنوین؟"
    }
  },
  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 1.1,
      "HIDE": 1.4
    },
    "SCRIPT": {
      "KOREAN": "환자분!",
      "ENGLISH": "Stay with me!",
      "PERSIAN": "چشماتونو باز نگه دارین!"
    }
  },
  {
