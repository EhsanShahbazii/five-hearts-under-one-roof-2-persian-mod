  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 3.0,
      "HIDE": 3.3
    },
    "SCRIPT": {
      "KOREAN": "다리가 이게..",
      "ENGLISH": "Your leg is...",
      "PERSIAN": "پاتون اینجوری..."
    }
  },
  {
    "INDEX": 6.0,
    "TIME": {
      "SHOW": 3.3,
      "HIDE": 4.0
    },
    "SCRIPT": {
      "KOREAN": "정신 차리세요!",
      "ENGLISH": "Come on, stay with me!",
      "PERSIAN": "هوشیار باشین، با من حرف بزنین!"
    }
  },
  {
    "INDEX": 7.0,
    "TIME": {
      "SHOW": 4.1,
      "HIDE": 5.0
    },
    "SCRIPT": {
      "KOREAN": "다리 움직이시면 안 됩니다.",
      "ENGLISH": "Don’t move your leg, okay?",
      "PERSIAN": "پاتونو اصلاً تکون ندین، باشه؟"
    }
  },
  {
    "INDEX": 8.0,
    "TIME": {
      "SHOW": 5.3,
      "HIDE": 5.9
    },
    "SCRIPT": {
      "KOREAN": "정신 차리세요 환자분.",
