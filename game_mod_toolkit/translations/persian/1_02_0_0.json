    "TIME": {
      "SHOW": 1.5,
      "HIDE": 3.0
    },
    "SCRIPT": {
      "KOREAN": "환자분 눈 감지 마시고 숨 쉬세요.",
      "ENGLISH": "Don’t close your eyes—keep breathing!",
      "PERSIAN": "چشماتونو نبندین، نفس بکشین!"
