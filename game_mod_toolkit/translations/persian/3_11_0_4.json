      "PORTUGUESE": "Vamos, joga, joga!",
      "SPANISH": "¡Vamos, lánzalo, lánzalo!",
      "PERSIAN": "بیا یه چیزی پرت کن من به شما جرات می کنم!"
    }
  },
  {
    "INDEX": 13.0,
    "TIME": {
      "SHOW": 21.5,
      "HIDE": 22.8
    },
    "SCRIPT": {
