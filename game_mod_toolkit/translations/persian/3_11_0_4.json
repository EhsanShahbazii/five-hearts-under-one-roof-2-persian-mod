[
  {
    "INDEX": 1.0,
    "TIME": {
      "HIDE": 1.5
    },
    "SCRIPT": {
      "KOREAN": "자 민정 님, 제 말 잘 들어요.",
      "ENGLISH": "Okay, Min-jung, listen to me carefully.",
      "CHINESE_SIMPLIFIED": "来敏静，听好了",
      "CHINESE_TRADITIONAL": "敏靜，聽好了",
      "JAPANESE": "ミンジョンさん、俺の言うことをよく聞いてください",
      "INDONESIAN": "Oke, Min-jung, dengerin aku baik-baik.",
      "PORTUGUESE": "Certo, Minjung, me escuta com atenção.",
      "SPANISH": "Bien, Minjung, escúchame con atención.",
      "PERSIAN": "باشه، مین‌جونگ، با دقت به من گوش کن."
    }
  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 1.6,
      "HIDE": 2.3
    },
    "SCRIPT": {
      "KOREAN": "(끄덕끄덕)",
      "ENGLISH": "(nods)",
      "CHINESE_SIMPLIFIED": "（点头）",
      "CHINESE_TRADITIONAL": "（點頭）",
      "JAPANESE": "（コクリ…）",
      "INDONESIAN": "(mengangguk)",
      "PORTUGUESE": "(Assente)",
      "SPANISH": "(Asiente)",
      "PERSIAN": "(سر تکان می دهد)"
    }
  },
  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 2.4,
      "HIDE": 3.9
    },
    "SCRIPT": {
      "KOREAN": "제가 민정 님 옆에 있는 이상",
      "ENGLISH": "As long as I’m standing next to you,",
      "CHINESE_SIMPLIFIED": "只要我站在敏静身边",
      "CHINESE_TRADITIONAL": "只要我站在你身邊",
      "JAPANESE": "俺がミンジョンさんのそばにいる限り",
      "INDONESIAN": "Selama aku berdiri di samping kamu,",
      "PORTUGUESE": "Enquanto eu estiver do seu lado,",
      "SPANISH": "Mientras esté a tu lado",
      "PERSIAN": "تا زمانی که کنارت ایستاده ام"
    }
  },
  {
    "INDEX": 4.0,
    "TIME": {
      "SHOW": 4.0,
      "HIDE": 6.7
    },
    "SCRIPT": {
      "KOREAN": "저 사람들은 제가 민정 님을 보호해 줄 거라고 생각할 거예요.",
      "ENGLISH": "they’ll think I’m here to protect you.",
      "CHINESE_SIMPLIFIED": "那些人就会以为我要保护你",
      "CHINESE_TRADITIONAL": "他們就會以為我要保護你",
      "JAPANESE": "あの人たちは俺があなたを守るって思うはずです",
      "INDONESIAN": "mereka bakal mikir aku di sini buat ngelindungin kamu.",
      "PORTUGUESE": "esse pessoal vai achar que eu vou te proteger.",
      "SPANISH": "esa gente va a pensar que voy a protegerte.",
      "PERSIAN": "اونا فکر می کنند من اینجا هستم تا از شما محافظت کنم."
    }
  },
  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 7.0,
      "HIDE": 8.3
    },
    "SCRIPT": {
      "KOREAN": "그래서 우리는 반대로 갑니다.",
      "ENGLISH": "So—we’re doing the opposite.",
      "CHINESE_SIMPLIFIED": "所以我们要反其道而行",
      "CHINESE_TRADITIONAL": "所以我們要反其道而行",
      "JAPANESE": "だから俺たちは逆に動きます",
      "INDONESIAN": "Jadi—kita lakuin yang sebaliknya.",
      "PORTUGUESE": "Então, a gente vai fazer o contrário.",
      "SPANISH": "Así que haremos lo contrario.",
      "PERSIAN": "بنابراین - ما برعکس عمل می کنیم."
    }
  },
  {
    "INDEX": 6.0,
    "TIME": {
      "SHOW": 8.4,
      "HIDE": 8.7
    },
    "SCRIPT": {
      "KOREAN": "네?",
      "ENGLISH": "Huh?",
      "CHINESE_SIMPLIFIED": "嗯？",
      "CHINESE_TRADITIONAL": "嗯？",
      "JAPANESE": "え？",
      "INDONESIAN": "Hah?",
      "PORTUGUESE": "Hã?",
      "SPANISH": "¿Eh?",
      "PERSIAN": "ها؟"
    }
  },
  {
    "INDEX": 7.0,
    "TIME": {
      "SHOW": 9.0,
      "HIDE": 9.9
    },
    "SCRIPT": {
      "KOREAN": "역발상인 거죠. ",
      "ENGLISH": "We flip the script.",
      "CHINESE_SIMPLIFIED": "就是逆向思维",
      "CHINESE_TRADITIONAL": "就是逆向思考啦",
      "JAPANESE": "逆転の発想です",
      "INDONESIAN": "Kita balik skenarionya.",
      "PORTUGUESE": "Um movimento inesperado.",
      "SPANISH": "Un movimiento inesperado.",
      "PERSIAN": "فیلمنامه را ورق می زنیم."
    }
  },
  {
    "INDEX": 8.0,
    "TIME": {
      "SHOW": 10.1,
      "HIDE": 13.7
    },
    "SCRIPT": {
      "KOREAN": "저들의 생각과 반대로 움직여서 틈이 생겼을 때 그때 제가 나서겠습니다.",
      "ENGLISH": "We move against their expectations, and when there’s an opening, I’ll make my move.",
      "CHINESE_SIMPLIFIED": "和他们的预判反着来，等出现空档时我再出手",
      "CHINESE_TRADITIONAL": "趁他們想法和我們相反，出現空檔時我就出手",
      "JAPANESE": "やつらの意表を突いて、隙ができた瞬間に俺が出ます",
      "INDONESIAN": "Kita gerak lawan ekspektasi mereka, dan pas ada celah, aku bakal ambil tindakan.",
      "PORTUGUESE": "Vamos nos mover na direção oposta ao que eles esperam, e quando surgir uma chance, eu ajo.",
      "SPANISH": "Nos moveremos en dirección contraria a lo que ellos esperan, y cuando haya una oportunidad, yo actuaré.",
      "PERSIAN": "ما برخلاف انتظار اون‌ها حرکت می‌کنیم، و زمانی که باز شود، حرکتم را انجام خواهم داد."
    }
  },
  {
    "INDEX": 9.0,
    "TIME": {
      "SHOW": 14.4,
      "HIDE": 14.7
    },
    "SCRIPT": {
      "KOREAN": "예?",
      "ENGLISH": "What...?",
      "CHINESE_SIMPLIFIED": "啊？",
      "CHINESE_TRADITIONAL": "啊？",
      "JAPANESE": "はいっ!?",
      "INDONESIAN": "Apa...??",
      "PORTUGUESE": "Ah?",
      "SPANISH": "¿Ah?",
      "PERSIAN": "چی...؟"
    }
  },
  {
    "INDEX": 10.0,
    "TIME": {
      "SHOW": 15.1,
      "HIDE": 18.3
    },
    "SCRIPT": {
      "KOREAN": "자, 공격! 이얏!!",
      "ENGLISH": "Alright—attack! Hyaaah!!",
      "CHINESE_SIMPLIFIED": "好，进攻！咿呀！！",
      "CHINESE_TRADITIONAL": "好了，攻擊！咿呀！！",
      "JAPANESE": "よし、攻撃！ いっけぇーっ！",
      "INDONESIAN": "Oke—serang! Hyaaah!!",
      "PORTUGUESE": "Vamos, atacar! Iyaa!",
      "SPANISH": "¡Vamos, al ataque! ¡Iyaa!",
      "PERSIAN": "خوب - حمله کن! هیاااا!!"
    }
  },
  {
    "INDEX": 11.0,
    "TIME": {
      "SHOW": 19.0,
      "HIDE": 20.2
    },
    "SCRIPT": {
      "KOREAN": "에헤~ 당황했지?? 당황했지??",
      "ENGLISH": "Heh~ You didn’t see that coming, huh? You’re panicking, right??",
      "CHINESE_SIMPLIFIED": "诶嘿~慌了吧？？慌了吧？？",
      "CHINESE_TRADITIONAL": "嘿嘿～嚇到了吧？嚇到了吧？",
      "JAPANESE": "へへ〜！ 驚いた？ 驚いたでしょ！？",
      "INDONESIAN": "Heh~ Nggak nyangka, ya? Panik, kan??",
      "PORTUGUESE": "Hein~! Se assustou, né? Não tava esperando por essa.",
      "SPANISH": "¡Eh~! ¿Te sorprendiste, verdad? no te lo esperabas.",
      "PERSIAN": "هه~ تو ندیدی که میاد، ها؟ شما وحشت زده اید، درست است؟"
    }
  },
  {
