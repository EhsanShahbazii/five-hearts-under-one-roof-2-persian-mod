    "TIME": {
      "SHOW": 60.5,
      "HIDE": 61.7
    },
    "SCRIPT": {
      "KOREAN": "자, 까미야",
      "ENGLISH": "Alright, Kkami...",
      "CHINESE_SIMPLIFIED": "来，小黑",
      "CHINESE_TRADITIONAL": "來，小黑",
      "JAPANESE": "ほら カミ",
      "INDONESIAN": "Baiklah, Kkami...",
      "PORTUGUESE": "Vem, Blacky.",
      "SPANISH": "Ven, Blacky.",
      "PERSIAN": "باشه ککامی..."
    }
  },
