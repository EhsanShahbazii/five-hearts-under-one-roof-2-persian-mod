      "HIDE": 3.0
    },
    "SCRIPT": {
      "KOREAN": "규리 쌤!",
      "ENGLISH": "Nurse Gyu-ri!",
      "CHINESE_SIMPLIFIED": "方护士！",
      "CHINESE_TRADITIONAL": "久梨護理師！",
      "JAPANESE": "ギュリ先生！",
      "INDONESIAN": "Suster Gyuri!",
      "PORTUGUESE": "Enfermeira Gyuri!",
      "SPANISH": "¡Enfermera Gyuri!",
      "PERSIAN": "پرستار گیو ری!"
    }
  },
  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 3.7,
      "HIDE": 5.0
    },
    "SCRIPT": {
      "KOREAN": "하지 말라니까!",
      "ENGLISH": "How many times have I told you not to do that!!",
      "CHINESE_SIMPLIFIED": "我不是说别这样吗！",
      "CHINESE_TRADITIONAL": "不是說不要這樣了嗎！",
      "JAPANESE": "やめてって言ったでしょ！",
      "INDONESIAN": "Kan aku udah bilang jangan!",
      "PORTUGUESE": "O que você tá fazendo?!",
      "SPANISH": "¡¿Qué estás haciendo?!",
      "PERSIAN": "چند بار بهت گفتم این کارو نکن!!"
    }
  },
  {
    "INDEX": 4.0,
    "TIME": {
      "SHOW": 5.9,
      "HIDE": 8.2
    },
    "SCRIPT": {
      "KOREAN": "붕대 쓰고 버리지 말라 그랬죠",
      "ENGLISH": "I told you not to throw away used bandages.",
      "CHINESE_SIMPLIFIED": "我说过，用过的绷带不要乱扔",
      "CHINESE_TRADITIONAL": "我說過，用過的繃帶不要亂丟吧",
      "JAPANESE": "包帯、使ったのをそのまま捨てないでって言ったでしょ",
      "INDONESIAN": "Aku udah bilang jangan buang perban yang udah dipakai!",
      "PORTUGUESE": "Eu te disse pra não jogar fora as bandagens usadas!",
      "SPANISH": "¡Te dije que no botaras las bendas usadas!",
      "PERSIAN": "بهت گفتم که بانداژهای استفاده شده رو دور نندازی."
    }
  },
  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 8.6,
      "HIDE": 10.5
    },
    "SCRIPT": {
      "KOREAN": "재사용하면 안 되잖아요.",
      "ENGLISH": "You’re not supposed to reuse them.",
      "CHINESE_SIMPLIFIED": "但是这个也不能重复使用啊",
      "CHINESE_TRADITIONAL": "但是這個也不能重複使用啊",
      "JAPANESE": "再利用しちゃダメなんじゃ",
      "INDONESIAN": "Nggak boleh dipakai ulang, kan?",
      "PORTUGUESE": "Mas não dá pra reutilizar.",
      "SPANISH": "Pero no se pueden reutilizar.",
      "PERSIAN": "قرار نیست دوباره ازشون استفاده کنی."
    }
  },
  {
    "INDEX": 6.0,
    "TIME": {
      "SHOW": 11.4,
      "HIDE": 12.4
    },
    "SCRIPT": {
