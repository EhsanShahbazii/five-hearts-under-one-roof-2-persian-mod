  {
    "INDEX": 8.0,
    "TIME": {
      "SHOW": 15.0,
      "HIDE": 17.1
    },
    "SCRIPT": {
      "KOREAN": "우린 쓰던 거 모은다고.",
      "ENGLISH": "We collect the used ones separately.",
      "CHINESE_SIMPLIFIED": "我们要把用过的收起来洗的",
      "CHINESE_TRADITIONAL": "我們會把用過的收集起來拿去洗的",
      "JAPANESE": "私たちは使ったものを集めてるの",
      "INDONESIAN": "Kita ngumpulin yang bekas-bekas, tau!",
      "PORTUGUESE": "Aqui a gente guarda separado.",
      "SPANISH": "Aquí las guardamos por separado.",
      "PERSIAN": "ما موارد استفاده شده را جداگانه جمع آوری می کنیم."
    }
  },
  {
    "INDEX": 9.0,
    "TIME": {
      "SHOW": 17.5,
      "HIDE": 19.1
    },
    "SCRIPT": {
      "KOREAN": "이거 가서 빨아 와!!!",
      "ENGLISH": "Go wash it. NOW!!!",
      "CHINESE_SIMPLIFIED": "拿去洗干净！！！",
      "CHINESE_TRADITIONAL": "你去把這個洗乾淨！！",
      "JAPANESE": "これ、持ってって洗ってきなさい！！！",
      "INDONESIAN": "Cuci ini sekarang juga!!!",
      "PORTUGUESE": "Vai lavar isso agora mesmo!",
      "SPANISH": "¡Ve y lávalas ahora mismo!",
      "PERSIAN": "برو بشورش. همین الان!!!"
    }
  },
  {
    "INDEX": 10.0,
    "TIME": {
      "SHOW": 22.6,
      "HIDE": 24.7
    },
    "SCRIPT": {
      "KOREAN": "야...너 대답 안 하니?",
      "ENGLISH": "Hey… are you not going to answer me?",
      "CHINESE_SIMPLIFIED": "喂...你不回话是吧？",
      "CHINESE_TRADITIONAL": "喂...你不回答嗎？",
      "JAPANESE": "おい…返事しないの？",
      "INDONESIAN": "Hey… kamu nggak jawab, ya?",
      "PORTUGUESE": "Não vai me responder?",
      "SPANISH": "¿No piensas responderme?",
      "PERSIAN": "هی... جوابمو نمیدی؟"
    }
  },
  {
    "INDEX": 11.0,
    "TIME": {
      "SHOW": 26.6,
      "HIDE": 30.5
    },
    "SCRIPT": {
      "KOREAN": "대답을, 하라고, 너 벙어리야?, 어?",
      "ENGLISH": "Answer me — are you mute or something? Huh?",
      "CHINESE_SIMPLIFIED": "我让你，回话，你是哑巴吗？嗯？",
      "CHINESE_TRADITIONAL": "叫你怎麼不回，你是啞巴嗎？嗯？",
      "JAPANESE": "返事しろって言ってるの、口がきけないの？あぁ？",
      "INDONESIAN": "Aku bilang jawab! Kamu bisu, ya? Hah?!",
      "PORTUGUESE": "Tô mandando responder. É muda ou o quê, hein?",
      "SPANISH": "Te dije que respondas. ¿Eres muda o qué, eh?",
      "PERSIAN": "جوابمو بده - لال شدی یا چی؟ ها؟"
