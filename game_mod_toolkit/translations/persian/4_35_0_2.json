    "TIME": {
      "SHOW": 30.3,
      "HIDE": 32.2
    },
    "SCRIPT": {
      "KOREAN": "그만 하라고 너네",
      "ENGLISH": "I said that’s enough, both of you.",
      "CHINESE_SIMPLIFIED": "我叫你们别说了",
