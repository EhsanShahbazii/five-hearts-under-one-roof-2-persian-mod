      "CHINESE_SIMPLIFIED": "你跟有娜是什么关系？",
      "CHINESE_TRADITIONAL": "你和有娜是什麼關係？",
      "JAPANESE": "ユナさんとどういう関係ですか？",
      "INDONESIAN": "Kamu tuh hubungan apa ya sama Yu-na?",
      "PORTUGUESE": "E que relação você tem com a Yuna?",
      "SPANISH": "¿Y qué relación tienes con Yuna?",
      "PERSIAN": "رابطه شما با یونا چیه؟"
    }
  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 3.6,
      "HIDE": 4.6
    },
    "SCRIPT": {
