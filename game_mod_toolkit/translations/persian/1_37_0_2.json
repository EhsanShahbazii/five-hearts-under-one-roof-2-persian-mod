[
  {
    "INDEX": 1.0,
    "TIME": {
      "HIDE": 1.5
    },
    "SCRIPT": {
      "KOREAN": "어이",
      "ENGLISH": "Hey.",
      "CHINESE_SIMPLIFIED": "喂！",
      "CHINESE_TRADITIONAL": "喂",
      "JAPANESE": "おい…",
      "INDONESIAN": "Hei.",
      "PORTUGUESE": "Ei.",
      "SPANISH": "¡Oye tú!",
      "PERSIAN": "هووی!"
    }
  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 1.5,
      "HIDE": 4.0
    },
    "SCRIPT": {
      "KOREAN": "《빛보다 빛나는 자》",
      "ENGLISH": "<O radiant one, shining brighter than light>",
      "CHINESE_SIMPLIFIED": "《比光更耀眼之人》",
      "CHINESE_TRADITIONAL": "《比光更耀眼的人》",
      "JAPANESE": "《光よりもなお輝く者よ》",
      "INDONESIAN": "Engkau yang lebih bersinar dari cahaya'",
      "PORTUGUESE": "<Ó radiante, mais brilhante que a luz>",
      "SPANISH": "《Más brillante que la luz》",
      "PERSIAN": "«ای درخشنده‌تر از هر نور!»"
    }
  },
  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 4.0,
      "HIDE": 6.0
    },
    "SCRIPT": {
      "KOREAN": "《심연보다도 깊고 어두운 자여》",
      "ENGLISH": "<O being, deeper and darker than the abyss>",
      "CHINESE_SIMPLIFIED": "《比深渊更深更暗之人啊》",
      "CHINESE_TRADITIONAL": "《比深淵更深邃更黑暗的人》",
      "JAPANESE": "《深淵よりもさらに深く、暗き者よ》",
      "INDONESIAN": "Engkau yang lebih dalam dan lebih gelap dari kegelapan'",
      "PORTUGUESE": "<Ó ser, mais profundo e sombrio que o abismo>",
      "SPANISH": "《Más oscuro y profundo que el abismo》",
      "PERSIAN": "«ای موجودی عمیق‌تر و تاریک‌تر از سیاه‌چاله‌های ابدیت!»"
    }
  },
  {
    "INDEX": 4.0,
    "TIME": {
      "SHOW": 6.0,
      "HIDE": 8.4
    },
    "SCRIPT": {
      "KOREAN": "- 뭔 소리야?\n- 《불보다 붉은 불의 용사여》",
      "ENGLISH": "- What the hell are you saying?\n- <O warrior, redder than fire itself>",
      "CHINESE_SIMPLIFIED": "- 这都什么乱七八糟的？\n-《比火焰更炽烈的火之勇士啊》",
      "CHINESE_TRADITIONAL": "- 你在說什麼？\n-《比火更赤紅的烈火勇士》",
      "JAPANESE": "- ……何言ってんだ？\n-《炎よりも赤き炎の戦士よ》",
      "INDONESIAN": "- Apa-apaan sih ini?\n- 'Engkau, sang pejuang api yang lebih merah dari api'",
      "PORTUGUESE": "- Que diabos você tá dizendo?\n- <Ó guerreiro, mais vermelho que o próprio fogo>",
      "SPANISH": "- ¿Qué estás diciendo...?\n-《Guerrero de fuego, más rojo que las llamas》",
      "PERSIAN": "- چی داری بلغور می‌کنی؟ - «ای دلاور سرخ‌تر از شعله‌های آتشین!»"
    }
  },
  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 8.4,
      "HIDE": 10.6
    },
    "SCRIPT": {
      "KOREAN": "《나 여기서 그대에게 바란다》",
      "ENGLISH": "<Here and now, I ask of you>",
      "CHINESE_SIMPLIFIED": "《在此，我向你祈求》",
      "CHINESE_TRADITIONAL": "《我在此對你提出要求》",
      "JAPANESE": "《ここにて、そなたに願わん》",
      "INDONESIAN": "Di sini, aku memohon padamu'",
      "PORTUGUESE": "<Aqui e agora, eu te invoco>",
      "SPANISH": "《Desde aquí, te lo imploro》",
      "PERSIAN": "«اینک در برابرت این تقاضا را دارم!»"
    }
  },
