  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 21.4,
      "HIDE": 23.5
    },
    "SCRIPT": {
      "KOREAN": "아저씨 좀만 천천히요...!",
      "ENGLISH": "Sir, could please you slow down a bit...?",
      "CHINESE_TRADITIONAL": "大叔，請再慢一點點...！",
      "INDONESIAN": "Pak, bisa pelan-pelan sedikit nggak...?",
      "PERSIAN": "آقا میشه لطفا یه کم سرعتتون رو کم کنید...؟"
    }
  },
  {
