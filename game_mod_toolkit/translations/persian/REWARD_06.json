  },
  {
    "INDEX": 4.0,
    "TIME": {
      "SHOW": 19.2,
      "HIDE": 20.5
    },
    "SCRIPT": {
      "KOREAN": "- 어...!\n- 어어!?",
      "ENGLISH": "—Uh...!\n—Whoa, hey?!",
      "CHINESE_TRADITIONAL": "-喔...! \n-喔喔！？",
      "INDONESIAN": "—Uh...!\n—Eh!?",
