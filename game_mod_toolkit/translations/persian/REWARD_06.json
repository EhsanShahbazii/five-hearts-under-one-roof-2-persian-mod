      "HIDE": 8.8
    },
    "SCRIPT": {
      "KOREAN": "- 감사합니다\n- 뭐야...",
      "ENGLISH": "—Thank you.\n—Wait... what?",
      "CHINESE_TRADITIONAL": "-謝謝\n-什麼啊...",
