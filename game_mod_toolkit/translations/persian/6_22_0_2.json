  },
  {
    "INDEX": 5.0,
    "TIME": {
      "SHOW": 9.5,
      "HIDE": 10.9
    },
    "SCRIPT": {
      "KOREAN": "유만 씨 저 오늘 회사 가요!",
      "ENGLISH": "Yuman! I’m heading to the office today!",
      "CHINESE_SIMPLIFIED": "宥万，我今天要去你公司！",
      "CHINESE_TRADITIONAL": "宥萬，我今天要去你公司！",
      "JAPANESE": "ユマンさん、今日会社行くんです！",
      "INDONESIAN": "Yuman! Hari ini aku ke kantor, ya!",
      "PORTUGUESE": "Yumán! Hoje eu vou pro escritório!",
      "SPANISH": "¡Yumán! ¡Hoy voy a la oficina!",
      "PERSIAN": "یومان! امروز میرم دفتر!"
    }
  },
  {
    "INDEX": 6.0,
    "TIME": {
      "SHOW": 11.0,
      "HIDE": 12.0
    },
    "SCRIPT": {
      "KOREAN": "오 진짜요? 왜요?",
      "ENGLISH": "Whoa, really? How come?",
