      "SPANISH": "¿En serio? ¿Por qué?",
      "PERSIAN": "وای، واقعا؟ چطور؟"
    }
  },
  {
    "INDEX": 7.0,
    "TIME": {
      "SHOW": 12.1,
      "HIDE": 14.1
    },
    "SCRIPT": {
