  {
    "INDEX": 3.0,
    "TIME": {
      "SHOW": 4.3,
      "HIDE": 5.5
    },
    "SCRIPT": {
      "KOREAN": "발표 잘할 수 있어요?",
      "ENGLISH": "You think you can pull off the presentation?",
      "CHINESE_SIMPLIFIED": "对你的汇报有信心吗，可以做好吧？",
      "CHINESE_TRADITIONAL": "可以好好的簡報嗎？",
      "JAPANESE": "発表うまくできそうですか？",
