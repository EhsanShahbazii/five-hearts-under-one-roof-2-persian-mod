  {
    "INDEX": 6.0,
    "TIME": {
      "SHOW": 6.7,
      "HIDE": 8.5
    },
    "SCRIPT": {
      "KOREAN": "아하하, 왜 이렇게 놀래요?",
      "ENGLISH": "Ahaha, why are you so jumpy?",
      "CHINESE_SIMPLIFIED": "哈哈哈，你怎么这么容易被吓到啊？",
      "CHINESE_TRADITIONAL": "哈哈哈，你太容易被嚇到了吧",
      "JAPANESE": "あはは、そんなに驚かなくても〜",
      "INDONESIAN": "Ahaha, kenapa sih kamu gampang kaget gitu?",
      "PORTUGUESE": "Hahaha, por que você se assusta tanto?",
      "SPANISH": "Jajaja, ¿por qué te asustas tanto?",
      "PERSIAN": "آهاااا چرا اینقدر پرت شدی"
    }
  },
  {
    "INDEX": 7.0,
    "TIME": {
      "SHOW": 9.2,
      "HIDE": 11.0
