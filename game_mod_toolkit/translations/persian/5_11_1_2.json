      "JAPANESE": "大丈夫なのに",
      "INDONESIAN": "Yakin?",
      "PORTUGUESE": "Tá bom...",
      "SPANISH": "Está bien...",
      "PERSIAN": "مطمئنی؟"
    }
  },
  {
