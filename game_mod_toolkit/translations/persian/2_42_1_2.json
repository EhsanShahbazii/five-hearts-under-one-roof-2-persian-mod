    },
    "SCRIPT": {
      "KOREAN": "몰라요?",
      "ENGLISH": "You don’t know?",
      "CHINESE_SIMPLIFIED": "你不认识吗？",
      "CHINESE_TRADITIONAL": "你不知道嗎？",
      "JAPANESE": "知らないですか？",
      "INDONESIAN": "Kamu tidak tahu?",
      "PORTUGUESE": "Não se lembra?",
