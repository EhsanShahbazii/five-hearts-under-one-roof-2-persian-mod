      "PERSIAN": "شما نمی دانید؟"
    }
  },
  {
    "INDEX": 2.0,
    "TIME": {
      "SHOW": 0.7,
      "HIDE": 1.8
    },
    "SCRIPT": {
      "KOREAN": "아까 들어오려다가 ",
