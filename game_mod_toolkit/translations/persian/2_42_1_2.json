      "PORTUGUESE": "a gente teve um pequeno desentendimento.",
      "SPANISH": "tuvimos un pequeño altercado.",
      "PERSIAN": "با این مرد قبل از درب."
    }
  },
  {
    "INDEX": 4.0,
    "TIME": {
      "SHOW": 4.6,
      "HIDE": 7.0
    },
    "SCRIPT": {
      "KOREAN": "음~ 전 그쪽 아는데. ",
      "ENGLISH": "Hmm~ I know you though.",
      "CHINESE_SIMPLIFIED": "嗯~我认识你！",
      "CHINESE_TRADITIONAL": "嗯～我知道",
